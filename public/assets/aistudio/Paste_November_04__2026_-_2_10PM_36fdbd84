function doGet(e) {
  const t = HtmlService.createTemplateFromFile('Index');
  t.page = (e && e.parameter && e.parameter.page === 'admin') ? 'admin' : 'form';
  return t.evaluate()
    .setTitle('U&M | Transporte de Colaboradores')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover');
}


/* ============ CONFIGURAÇÃO (rode uma vez) ============ */

function configurarSistema() {
  const props = PropertiesService.getScriptProperties();
  const ss = planilha_();
  abaDe_(CONFIG.ABA, CAMPOS);
  abaDe_(CONFIG.ABA_PONTOS, CAMPOS_PONTO);
  semearRotas_();
  pasta_();
  if (!props.getProperty('SENHA_ADMIN')) {
    props.setProperty('SENHA_ADMIN', 'troque-esta-senha');
    Logger.log('ATENÇÃO: senha provisória criada. Troque em Configurações do projeto > Propriedades do script > SENHA_ADMIN.');
  }
  Logger.log('Planilha: ' + ss.getUrl());
  const url = ScriptApp.getService().getUrl();
  if (url) {
    Logger.log('Link do colaborador: ' + url);
    Logger.log('Link do admin: ' + url + '?page=admin');
  } else {
    Logger.log('Implante como App da Web para gerar os links.');
  }
  Logger.log('Próximo passo: rode prepararMapaDasRotas para localizar as ruas das rotas no mapa.');
}

// Localiza no mapa as ruas de todas as linhas (pode rodar quantas vezes quiser)
function prepararMapaDasRotas() {
  const r = prepararMapaDasRotas_(1000, 300000, null);
  Logger.log('Localizadas agora: ' + r.feitos + ' | Encontradas no total: ' + r.localizados + ' de ' + r.total + ' | Faltam: ' + r.faltam);
  if (r.faltam) Logger.log('Ainda faltam pontos: rode prepararMapaDasRotas de novo.');
}


/* ============ COLABORADOR ============ */

function enviarCadastro(d) {
  d = d || {};
  if (d.site) return { ok: true, protocolo: '—', rota: null }; // campo-armadilha contra robôs
  OBRIGATORIOS.forEach(function (k) {
    if (!String(d[k] || '').trim()) throw new Error('Preencha o campo: ' + rotulo_(k));
  });
  if (!d.consentimento) throw new Error('Marque a autorização de uso dos dados para enviar.');

  const r = montar_(d, CAMPOS_COLAB);
  const sug = calcularRotaSegura_(r);

  return comLock_(function () {
    r.id = novoId_();
    r.criadoEm = agora_();
    r.atualizadoEm = r.criadoEm;
    r.status = sug.encontrada ? 'Rota sugerida' : 'Novo';
    r.onibus = sug.encontrada ? sug.label : '';
    r.obs = '';
    aplicarSugestao_(r, sug);
    r.fotoId = salvarFoto_(d.foto, r.id + ' - ' + r.nome);
    anexar_(abaDe_(CONFIG.ABA, CAMPOS), CAMPOS, r);
    return { ok: true, protocolo: r.id, rota: rotaPublica_(sug) };
  });
}


/* ============ ADMIN: LOGIN ============ */

function login(senha) {
  const cache = CacheService.getScriptCache();
  const falhas = Number(cache.get('falhas_login') || 0);
  if (falhas >= CONFIG.MAX_TENTATIVAS) throw new Error('Muitas tentativas erradas. Aguarde 10 minutos.');
  const certa = PropertiesService.getScriptProperties().getProperty('SENHA_ADMIN');
  if (!certa) throw new Error('Sistema não configurado. Rode a função configurarSistema no editor.');
  Utilities.sleep(300);
  if (String(senha || '') !== certa) {
    cache.put('falhas_login', String(falhas + 1), 600);
    throw new Error('Senha incorreta.');
  }
  cache.remove('falhas_login');
  const token = Utilities.getUuid();
  cache.put('sess_' + token, '1', Math.min(CONFIG.HORAS_SESSAO, 6) * 3600);
  return token;
}

function sair(token) {
  if (token) CacheService.getScriptCache().remove('sess_' + token);
  return true;
}


/* ============ ADMIN: CADASTROS ============ */

function listarCadastros(token) {
  exigirAdmin_(token);
  return {
    registros: lerTudo_().map(semLinha_).reverse(), // mais recentes primeiro
    rotas: lerRotas_().map(semLinha_),
    mapa: resumoMapa_(),
    planilhaUrl: planilha_().getUrl()
  };
}

function salvarCadastro(token, d) {
  exigirAdmin_(token);
  d = d || {};
  if (!String(d.nome || '').trim()) throw new Error('Informe o nome.');
  if (d.id) {
    return comLock_(function () {
      const atual = acharOuErro_(d.id);
      const novo = Object.assign({}, atual, montar_(d, CAMPOS_ADMIN));
      if (novo.endereco !== atual.endereco || novo.bairro !== atual.bairro || novo.cidade !== atual.cidade) novo.coord = '';
      novo.atualizadoEm = agora_();
      gravar_(novo);
      return semLinha_(novo);
    });
  }
  const r = montar_(d, CAMPOS_ADMIN);
  const sug = calcularRotaSegura_(r);
  return comLock_(function () {
    r.id = novoId_();
    r.criadoEm = agora_();
    r.atualizadoEm = r.criadoEm;
    aplicarSugestao_(r, sug);
    if (!r.onibus && sug.encontrada) { r.onibus = sug.label; if (r.status === 'Novo') r.status = 'Rota sugerida'; }
    r.fotoId = salvarFoto_(d.foto, r.id + ' - ' + r.nome);
    anexar_(abaDe_(CONFIG.ABA, CAMPOS), CAMPOS, r);
    return semLinha_(r);
  });
}

function recalcularRota(token, id) {
  exigirAdmin_(token);
  const base = acharOuErro_(id);
  const sug = calcularRotaSegura_(base);
  return comLock_(function () {
    const r = acharOuErro_(id);
    aplicarSugestao_(r, sug);
    if (sug.encontrada) {
      r.onibus = sug.label;
      if (r.status === 'Novo' || r.status === 'Rota sugerida') r.status = 'Rota sugerida';
    }
    r.atualizadoEm = agora_();
    gravar_(r);
    return { registro: semLinha_(r), sugestao: rotaPublica_(sug) };
  });
}

function alterarStatus(token, id, status) {
  exigirAdmin_(token);
  if (STATUS.indexOf(status) < 0) throw new Error('Status inválido.');
  return comLock_(function () {
    const r = acharOuErro_(id);
    r.status = status;
    r.atualizadoEm = agora_();
    gravar_(r);
    return semLinha_(r);
  });
}

function alterarFoto(token, id, foto) {
  exigirAdmin_(token);
  return comLock_(function () {
    const r = acharOuErro_(id);
    const antiga = r.fotoId;
    r.fotoId = foto ? salvarFoto_(foto, r.id + ' - ' + r.nome) : '';
    r.atualizadoEm = agora_();
    gravar_(r);
    apagarFoto_(antiga);
    return { fotoId: r.fotoId };
  });
}

function excluirCadastro(token, id) {
  exigirAdmin_(token);
  return comLock_(function () {
    const r = acharOuErro_(id);
    abaDe_(CONFIG.ABA, CAMPOS).deleteRow(r._linha);
    apagarFoto_(r.fotoId);
    return true;
  });
}

function getFotos(token, ids) {
  exigirAdmin_(token);
  const regs = lerTudo_();
  const mapa = {};
  (ids || []).slice(0, 20).forEach(function (id) {
    const r = regs.find(function (x) { return x.id === id; });
    if (!r || !r.fotoId) return;
    try {
      const b = DriveApp.getFileById(r.fotoId).getBlob();
      mapa[id] = 'data:' + b.getContentType() + ';base64,' + Utilities.base64Encode(b.getBytes());
    } catch (e) { /* foto apagada no Drive */ }
  });
  return mapa;
}


/* ============ ADMIN: ROTAS ============ */

function listarRotas(token) {
  exigirAdmin_(token);
  return { rotas: lerRotas_().map(semLinha_), mapa: resumoMapa_() };
}

function salvarRota(token, d) {
  exigirAdmin_(token);
  d = d || {};
  const turma = limpar_(d.turma, 80), linha = limpar_(d.linha, 60);
  const itens = listaItinerario_(d.itinerario);
  if (!turma) throw new Error('Escolha a turma da linha.');
  if (!linha) throw new Error('Informe o nome da linha. Ex.: Linha 04');
  if (itens.length < 2) throw new Error('Informe o itinerário com pelo menos duas ruas, uma por linha.');
  return comLock_(function () {
    const sh = abaDe_(CONFIG.ABA_ROTAS, CAMPOS_ROTA);
    const r = {
      turma: turma, linha: linha,
      horario: limpar_(d.horario, 40), km: limpar_(d.km, 20),
      itinerario: itens.map(function (i) { return limpar_(i, 160); }).join('\n').slice(0, 8000),
      bairrosExtras: limpar_(d.bairrosExtras, 500),
      ativa: d.ativa === false || d.ativa === 'NÃO' ? 'NÃO' : 'SIM',
      atualizadoEm: agora_()
    };
    if (d.id) {
      const atual = lerTabela_(sh, CAMPOS_ROTA).find(function (x) { return x.id === d.id; });
      if (!atual) throw new Error('Linha não encontrada. Toque em Atualizar.');
      const novo = Object.assign({}, atual, r);
      gravarLinha_(sh, CAMPOS_ROTA, novo);
      return semLinha_(novo);
    }
    r.id = 'R' + Utilities.getUuid().replace(/-/g, '').slice(0, 6).toUpperCase();
    anexar_(sh, CAMPOS_ROTA, r);
    return r;
  });
}

function excluirRota(token, id) {
  exigirAdmin_(token);
  return comLock_(function () {
    const sh = abaDe_(CONFIG.ABA_ROTAS, CAMPOS_ROTA);
    const r = lerTabela_(sh, CAMPOS_ROTA).find(function (x) { return x.id === id; });
    if (!r) throw new Error('Linha não encontrada.');
    sh.deleteRow(r._linha);
    return true;
  });
}

function prepararMapa(token) {
  exigirAdmin_(token);
  return prepararMapaDasRotas_(40, 240000, null);
}


/* ============ ROTAS: MAPA E SUGESTÃO ============ */

function calcularRotaSegura_(cad) {
  try { return calcularRota_(cad); }
  catch (e) { return { encontrada: false, motivo: 'Não foi possível calcular a rota agora. A administração vai definir sua rota.' }; }
}

function calcularRota_(cad) {
  const rotas = lerRotas_();
  let geo = null;
  if (CONFIG.USAR_MAPA) {
    try {
      let coord = lerCoord_(cad.coord);
      if (!coord) coord = localizarColaborador_(cad);
      if (coord) {
        prepararMapaDasRotas_(15, 20000, cad.turma); // garante os pontos das linhas deste turno
        geo = { coord: coord, pontos: lerPontos_() };
      }
    } catch (e) { geo = null; }
  }
  const s = sugerirRota_(cad, rotas, geo);
  s._coord = geo ? geo.coord.lat.toFixed(6) + ',' + geo.coord.lng.toFixed(6) + (geo.coord.precisao === 'bairro' ? ',bairro' : '') : '';
  return s;
}

function aplicarSugestao_(r, sug) {
  r.rotaSugerida = sug.encontrada ? sug.label : '';
  r.rotaMotivo = sug.encontrada
    ? 'Confiança ' + sug.confianca + ': ' + sug.motivo + (sug.alternativas && sug.alternativas.length ? '. Outras opções: ' + sug.alternativas.map(function (a) { return a.label; }).join(', ') : '')
    : sug.motivo;
  if (sug._coord) r.coord = sug._coord;
}

function rotaPublica_(s) {
  if (!s || !s.encontrada) return { encontrada: false, motivo: s ? s.motivo : '' };
  return {
    encontrada: true, label: s.label, linha: s.linha, turma: s.turma, horario: s.horario, km: s.km,
    inicio: s.inicio, itinerario: s.itinerario, confianca: s.confianca, motivo: s.motivo, distanciaM: s.distanciaM
  };
}

function lerCoord_(txt) {
  const p = String(txt || '').split(',');
  const lat = parseFloat(p[0]), lng = parseFloat(p[1]);
  if (isNaN(lat) || isNaN(lng)) return null;
  return { lat: lat, lng: lng, precisao: p[2] === 'bairro' ? 'bairro' : 'endereco' };
}

function localizarColaborador_(cad) {
  const cidade = String(cad.cidade || 'Parauapebas').trim();
  let g = geocode_([cad.endereco, cad.bairro, cidade].filter(Boolean).join(', ') + ' - PA');
  if (g) { g.precisao = 'endereco'; return g; }
  if (cad.bairro) {
    g = geocode_('Bairro ' + cad.bairro + ', ' + cidade + ' - PA');
    if (g) { g.precisao = 'bairro'; return g; }
  }
  return null;
}

function geocode_(texto) {
  const resp = Maps.newGeocoder().setRegion('br').setLanguage('pt-BR')
    .setBounds(-6.45, -50.25, -5.70, -49.55).geocode(texto);
  if (!resp || resp.status !== 'OK' || !resp.results || !resp.results.length) return null;
  const res = resp.results[0];
  const tipos = res.types || [];
  const amplo = ['locality', 'administrative_area_level_1', 'administrative_area_level_2', 'country', 'postal_code'];
  if (tipos.some(function (t) { return amplo.indexOf(t) >= 0; })) return null; // só achou a cidade
  const loc = res.geometry.location;
  if (distM_(loc.lat, loc.lng, CENTRO_MAPA.lat, CENTRO_MAPA.lng) > 45000) return null;
  return { lat: loc.lat, lng: loc.lng };
}

function prepararMapaDasRotas_(limite, tempoMax, soTurma) {
  const inicio = Date.now();
  const sh = abaDe_(CONFIG.ABA_PONTOS, CAMPOS_PONTO);
  const pontos = lerPontos_();
  const todas = [];
  lerRotas_().filter(rotaAtiva_).forEach(function (r) {
    if (soTurma && String(r.turma).trim() !== String(soTurma).trim()) return;
    itensDaRota_(r).forEach(function (i) { const q = consultaDoItem_(i); if (q && todas.indexOf(q) < 0) todas.push(q); });
  });
  const faltam = todas.filter(function (q) { return !pontos[q]; });
  const novas = [];
  for (let k = 0; k < faltam.length; k++) {
    if (novas.length >= limite || Date.now() - inicio > tempoMax) break;
    let g = null;
    try { g = geocode_(faltam[k]); }
    catch (e) { break; } // cota do dia atingida: tenta de novo depois
    novas.push([faltam[k], g ? String(g.lat) : '', g ? String(g.lng) : '', g ? 'ok' : 'não encontrado', agora_()]);
    pontos[faltam[k]] = g ? { lat: g.lat, lng: g.lng } : { lat: null };
    Utilities.sleep(100);
  }
  if (novas.length) sh.getRange(sh.getLastRow() + 1, 1, novas.length, CAMPOS_PONTO.length).setValues(novas);
  return {
    feitos: novas.length,
    faltam: faltam.length - novas.length,
    total: todas.length,
    localizados: todas.filter(function (q) { return pontos[q] && pontos[q].lat; }).length
  };
}

function resumoMapa_() {
  const pontos = lerPontos_();
  const todas = [];
  lerRotas_().filter(rotaAtiva_).forEach(function (r) {
    itensDaRota_(r).forEach(function (i) { const q = consultaDoItem_(i); if (q && todas.indexOf(q) < 0) todas.push(q); });
  });
  return {
    total: todas.length,
    faltam: todas.filter(function (q) { return !pontos[q]; }).length,
    localizados: todas.filter(function (q) { return pontos[q] && pontos[q].lat; }).length
  };
}

function lerPontos_() {
  const mapa = {};
  lerTabela_(abaDe_(CONFIG.ABA_PONTOS, CAMPOS_PONTO), CAMPOS_PONTO).forEach(function (p) {
    const lat = parseFloat(p.lat), lng = parseFloat(p.lng);
    mapa[p.consulta] = isNaN(lat) ? { lat: null } : { lat: lat, lng: lng };
  });
  return mapa;
}

function lerRotas_() {
  return lerTabela_(abaDe_(CONFIG.ABA_ROTAS, CAMPOS_ROTA), CAMPOS_ROTA);
}

function semearRotas_() {
  const sh = abaDe_(CONFIG.ABA_ROTAS, CAMPOS_ROTA);
  if (sh.getLastRow() > 1) return;
  const agora = agora_();
  const linhas = ROTAS_INICIAIS.map(function (r) {
    return paraLinhaDe_(CAMPOS_ROTA, Object.assign({}, r, {
      itinerario: listaItinerario_(r.itinerario).join('\n'), bairrosExtras: '', ativa: 'SIM', atualizadoEm: agora
    }));
  });
  sh.getRange(2, 1, linhas.length, CAMPOS_ROTA.length).setValues(linhas);
  sh.setColumnWidth(6, 420);
  sh.getRange(2, 6, linhas.length, 1).setWrap(true);
}


/* ============ AUXILIARES ============ */

function exigirAdmin_(token) {
  if (!token || !CacheService.getScriptCache().get('sess_' + token)) throw new Error('SESSAO_EXPIRADA');
}

function planilha_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty('PLANILHA_ID');
  let ss = null;
  if (id) { try { ss = SpreadsheetApp.openById(id); } catch (e) { ss = null; } }
  if (!ss) {
    ss = SpreadsheetApp.create(CONFIG.NOME_PLANILHA);
    ss.getSheets()[0].setName(CONFIG.ABA);
    props.setProperty('PLANILHA_ID', ss.getId());
  }
  return ss;
}

// Abre (ou cria) uma aba e garante o cabeçalho com todas as colunas
function abaDe_(nome, campos) {
  const ss = planilha_();
  let sh = ss.getSheetByName(nome);
  if (!sh) sh = ss.insertSheet(nome);
  const cols = sh.getLastColumn();
  const cab = cols ? sh.getRange(1, 1, 1, cols).getDisplayValues()[0].filter(String) : [];
  if (cab.length < campos.length) {
    sh.getRange(1, 1, sh.getMaxRows(), campos.length).setNumberFormat('@');
    sh.getRange(1, 1, 1, campos.length).setValues([campos.map(function (c) { return c[1]; })])
      .setFontWeight('bold').setBackground('#1b6e47').setFontColor('#ffffff');
    sh.setFrozenRows(1);
  }
  return sh;
}

function lerTabela_(sh, campos) {
  const n = sh.getLastRow();
  if (n < 2) return [];
  const vals = sh.getRange(2, 1, n - 1, campos.length).getDisplayValues();
  return vals.map(function (linha, i) {
    const o = { _linha: i + 2 };
    campos.forEach(function (c, j) { o[c[0]] = String(linha[j]).replace(/^'/, ''); });
    return o;
  }).filter(function (o) { return o[campos[0][0]]; });
}

function paraLinhaDe_(campos, r) {
  return campos.map(function (c) { return r[c[0]] == null ? '' : r[c[0]]; });
}
function gravarLinha_(sh, campos, r) {
  sh.getRange(r._linha, 1, 1, campos.length).setValues([paraLinhaDe_(campos, r)]);
}
function anexar_(sh, campos, r) {
  sh.getRange(sh.getLastRow() + 1, 1, 1, campos.length).setValues([paraLinhaDe_(campos, r)]);
}

function lerTudo_() { return lerTabela_(abaDe_(CONFIG.ABA, CAMPOS), CAMPOS); }
function gravar_(r) { gravarLinha_(abaDe_(CONFIG.ABA, CAMPOS), CAMPOS, r); }

function acharOuErro_(id) {
  const r = lerTudo_().find(function (x) { return x.id === id; });
  if (!r) throw new Error('Cadastro não encontrado. Ele pode ter sido excluído; toque em Atualizar.');
  return r;
}

function semLinha_(r) {
  const o = Object.assign({}, r);
  delete o._linha;
  return o;
}

function montar_(d, campos) {
  const o = {};
  campos.forEach(function (k) { o[k] = limpar_(d[k], LIMITES[k], k === 'obs'); });
  if ('status' in o && STATUS.indexOf(o.status) < 0) o.status = 'Novo';
  return o;
}

// Remove espaços extras, limita tamanho e impede fórmulas na planilha
function limpar_(v, max, multilinha) {
  let s = String(v == null ? '' : v);
  s = multilinha ? s.replace(/[ \t]+/g, ' ').trim() : s.replace(/\s+/g, ' ').trim();
  s = s.slice(0, max || 200);
  if (/^[=+\-@]/.test(s)) s = "'" + s;
  return s;
}

function pasta_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty('PASTA_ID');
  if (id) { try { return DriveApp.getFolderById(id); } catch (e) { } }
  const p = DriveApp.createFolder(CONFIG.PASTA_FOTOS);
  props.setProperty('PASTA_ID', p.getId());
  return p;
}

function salvarFoto_(foto, nome) {
  if (!foto || !foto.base64) return '';
  const tipos = ['image/jpeg', 'image/png', 'image/webp'];
  if (tipos.indexOf(foto.tipo) < 0) throw new Error('Formato de foto não aceito. Use JPG ou PNG.');
  const bytes = Utilities.base64Decode(foto.base64);
  if (bytes.length > CONFIG.FOTO_MAX_MB * 1024 * 1024) throw new Error('Foto muito grande (máx. ' + CONFIG.FOTO_MAX_MB + ' MB).');
  const ext = foto.tipo === 'image/png' ? '.png' : (foto.tipo === 'image/webp' ? '.webp' : '.jpg');
  return pasta_().createFile(Utilities.newBlob(bytes, foto.tipo, nome + ext)).getId();
}

function apagarFoto_(id) {
  if (!id) return;
  try { DriveApp.getFileById(id).setTrashed(true); } catch (e) { }
}

function comLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try { return fn(); } finally { lock.releaseLock(); }
}

function novoId_() {
  return 'UM' + Utilities.formatDate(new Date(), CONFIG.FUSO, 'yyMMdd') + '-' +
    Utilities.getUuid().replace(/-/g, '').slice(0, 4).toUpperCase();
}

function agora_() {
  return Utilities.formatDate(new Date(), CONFIG.FUSO, 'dd/MM/yyyy HH:mm');
}

function rotulo_(k) {
  const c = CAMPOS.find(function (x) { return x[0] === k; });
  return c ? c[1] : k;
}
const RAIO_ROTA_M = 2500;                       // acima disso a distância não conta pontos
const CENTRO_MAPA = { lat: -6.0675, lng: -49.9025 }; // Parauapebas

function semAcento_(s) {
  return String(s || '').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}

// Deixa nomes comparáveis: "Av. dos Ypês" e "AVENIDA IPES" viram "IPES"
function canon_(s) {
  let t = semAcento_(s).replace(/\([^)]*\)/g, ' ').replace(/[^A-Z0-9 ]+/g, ' ').replace(/Y/g, 'I');
  let tk = t.split(/\s+/).filter(Boolean);
  const PREF = ['RUA', 'R', 'AVENIDA', 'AV', 'AVE', 'RODOVIA', 'ROD', 'ESTRADA', 'EST', 'TRAVESSA', 'TV', 'TRAV',
    'ALAMEDA', 'AL', 'PRACA', 'BAIRRO', 'LOTEAMENTO', 'LOT', 'CONJUNTO', 'CONJ', 'RESIDENCIAL', 'RES', 'SETOR', 'W'];
  while (tk.length > 1 && PREF.indexOf(tk[0]) >= 0) tk.shift();
  if (tk.length > 1) tk = tk.filter(function (w) { return ['DE', 'DA', 'DO', 'DAS', 'DOS'].indexOf(w) < 0; });
  tk = tk.map(function (w) { return w === 'PARK' ? 'PARQUE' : (/^\d+$/.test(w) ? String(Number(w)) : w); });
  return tk.join(' ');
}

function tipoItem_(orig) {
  const u = semAcento_(orig).trim();
  if (/^PORTARIA/.test(u)) return 'portaria';
  if (/^(PA ?-?\d+|ROD\b|RODOVIA|ESTRADA|PERIMETRAL|RUA PERIMETRAL|VS ?-?10)/.test(u)) return 'rodovia';
  if (/^BAIRRO\b/.test(u)) return 'bairro';
  if (/^(RUA|R\.|AV\b|AV\.|AVENIDA|TRAVESSA|ALAMEDA|PRACA|W\.)/.test(u)) return 'via';
  return 'local';
}

function listaItinerario_(txt) {
  const s = String(txt || '').replace(/\r/g, '');
  let partes = s.split('\n');
  if (partes.filter(function (p) { return p.trim(); }).length <= 1) partes = s.split(/[,;]/);
  return partes.map(function (p) {
    return p.replace(/^\s*IN[IÍ]CIO\s*:?\s*/i, '').replace(/\.{2,}/g, '').replace(/\s+/g, ' ').trim();
  }).filter(Boolean);
}

function itensDaRota_(rota) {
  return listaItinerario_(rota.itinerario).map(function (o) {
    return { orig: o, tipo: tipoItem_(o), canon: canon_(o) };
  });
}

function lev_(a, b) {
  const m = a.length, n = b.length;
  if (!m) return n; if (!n) return m;
  let ant = []; for (let j = 0; j <= n; j++) ant[j] = j;
  for (let i = 1; i <= m; i++) {
    const cur = [i];
    for (let j = 1; j <= n; j++) {
      cur[j] = Math.min(ant[j] + 1, cur[j - 1] + 1, ant[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
    }
    ant = cur;
  }
  return ant[n];
}

// Aceita pequenas diferenças de grafia (FLAUSINO x FLAUZINO, LEMOS x LERMOS)
function parecido_(a, b) {
  if (!a || !b) return false;
  if (a === b) return true;
  const m = Math.min(a.length, b.length);
  if (m < 5) return false;
  if (a.indexOf(b + ' ') === 0 || b.indexOf(a + ' ') === 0) return true;
  const d = lev_(a, b);
  return (m >= 6 && d <= 1) || (m >= 10 && d <= 2);
}

// "Rua Marabá, 120, Qd 10" -> ["MARABA"]
function enderecoSegmentos_(end) {
  return semAcento_(end).split(/[,;\/]| - /).map(function (p) {
    p = p.replace(/\b(N|NO|NUMERO|QD|QUADRA|LT|LOTE|CASA|APTO|AP|BLOCO|BL|KM|SN)\b[\s\S]*$/, ' ').replace(/Nº.*$/, ' ');
    let tk = canon_(p).split(' ').filter(Boolean);
    if (tk.length >= 2 && /^\d+$/.test(tk[tk.length - 1]) && /[A-Z]{3,}/.test(tk[tk.length - 2])) tk.pop();
    return tk.join(' ');
  }).filter(function (s, k) { return s && (k === 0 || !/^\d+$/.test(s)); }); // número solto = nº da casa
}

function distM_(lat1, lng1, lat2, lng2) {
  const R = 6371000, rad = Math.PI / 180;
  const dLat = (lat2 - lat1) * rad, dLng = (lng2 - lng1) * rad;
  const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(lat1 * rad) * Math.cos(lat2 * rad) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
  return 2 * R * Math.asin(Math.sqrt(a));
}

function textoDistancia_(m) {
  return m < 1000 ? (Math.max(50, Math.round(m / 50) * 50)) + ' m' : (m / 1000).toFixed(1).replace('.', ',') + ' km';
}

// Texto que o Google Maps vai localizar para cada ponto da rota
function consultaDoItem_(i) {
  if (i.tipo === 'portaria' || i.tipo === 'rodovia' || !i.canon || i.canon.length <= 3) return '';
  return String(i.orig).replace(/\([^)]*\)/g, ' ').replace(/\s+/g, ' ').trim() + ', Parauapebas - PA';
}

function labelRota_(r) { return (r.linha || '') + ' — ' + (r.turma || ''); }
function rotaAtiva_(r) { return !/^N/i.test(String(r.ativa || 'SIM').trim()); }

/**
 * Escolhe a linha do turno do colaborador que passa mais perto dele.
 * Pontua: bairro no itinerário, rua do endereço no itinerário, ponto de embarque citado
 * e, se houver mapa, a distância até o ponto da rota mais próximo.
 */
function sugerirRota_(cad, rotas, geo) {
  const todas = (rotas || []).filter(rotaAtiva_);
  const turma = String(cad.turma || '').trim();
  const daTurma = todas.filter(function (r) { return String(r.turma).trim() === turma; });
  if (!daTurma.length) {
    return { encontrada: false, motivo: 'Ainda não há linhas cadastradas para ' + (turma || 'esta turma') + '. A administração vai informar sua rota.' };
  }
  // vias que aparecem em quase todas as linhas (perto da portaria) valem pouco
  const df = {};
  todas.forEach(function (r) {
    const visto = {};
    itensDaRota_(r).forEach(function (i) { if (i.canon && !visto[i.canon]) { visto[i.canon] = 1; df[i.canon] = (df[i.canon] || 0) + 1; } });
  });
  const N = todas.length;
  const peso = function (c) { return ((df[c] || 1) / N >= 0.5) ? 0.15 : 1; };
  const bairro = canon_(cad.bairro);
  const segs = enderecoSegmentos_(cad.endereco);
  const ponto = ' ' + canon_(cad.ponto) + ' ';

  const res = daTurma.map(function (r) {
    const itens = itensDaRota_(r).filter(function (i) { return i.canon && i.tipo !== 'portaria'; });
    let score = 0; const motivos = [];

    const bairrosLinha = itens.filter(function (i) { return i.tipo === 'bairro' || i.tipo === 'local'; }).map(function (i) { return i.canon; })
      .concat(String(r.bairrosExtras || '').split(/[,;\n]/).map(canon_).filter(Boolean));
    const passaBairro = bairro.length >= 3 && bairrosLinha.some(function (c) { return parecido_(c, bairro); });
    if (passaBairro) { score += 10; motivos.push('passa pelo bairro ' + String(cad.bairro).trim()); }

    let ptsRua = 0, rua = '';
    itens.forEach(function (i) {
      if (i.tipo === 'bairro') return;
      const generica = i.canon.length <= 3;
      const ok = segs.some(function (s) { return generica ? s === i.canon : parecido_(s, i.canon); });
      if (!ok) return;
      const p = (generica ? (passaBairro ? 4 : 1.5) : 8) * peso(i.canon);
      if (p > ptsRua) { ptsRua = p; rua = i.orig.replace(/\s*\([^)]*\)/g, ''); }
    });
    if (ptsRua) { score += ptsRua; motivos.push('o itinerário inclui ' + rua); }

    if (ponto.trim()) {
      const achou = itens.find(function (i) { return i.canon.length > 3 && i.tipo !== 'bairro' && ponto.indexOf(' ' + i.canon + ' ') >= 0; });
      if (achou) { score += 4 * peso(achou.canon); motivos.push('o ponto de embarque cita ' + achou.orig.replace(/\s*\([^)]*\)/g, '')); }
    }

    let dist = null;
    if (geo && geo.coord && geo.pontos) {
      itens.forEach(function (i) {
        const q = consultaDoItem_(i); const p = q && geo.pontos[q];
        if (p && p.lat) {
          const d = distM_(geo.coord.lat, geo.coord.lng, p.lat, p.lng);
          if (dist === null || d < dist) dist = d;
        }
      });
      if (dist !== null) {
        const fator = geo.coord.precisao === 'bairro' ? 0.5 : 1;
        const pd = 12 * Math.max(0, 1 - dist / RAIO_ROTA_M) * fator;
        if (pd > 0) { score += pd; motivos.push('fica a cerca de ' + textoDistancia_(dist) + ' de um ponto da rota'); }
      }
    }
    return { rota: r, score: score, motivos: motivos, dist: dist };
  }).sort(function (a, b) {
    return (b.score - a.score) || ((a.dist == null ? 1e9 : a.dist) - (b.dist == null ? 1e9 : b.dist));
  });

  const top = res[0];
  if (!top || top.score <= 0) {
    return { encontrada: false, motivo: 'Não encontramos sua rua ou seu bairro nos itinerários do ' + turma + '. A administração vai definir sua rota.' };
  }
  const r = top.rota;
  const itin = listaItinerario_(r.itinerario);
  return {
    encontrada: true,
    rotaId: r.id, label: labelRota_(r), turma: r.turma, linha: r.linha, horario: r.horario, km: r.km,
    inicio: itin[0] || '', itinerario: itin,
    confianca: top.score >= 14 ? 'alta' : (top.score >= 7 ? 'média' : 'baixa'),
    motivo: top.motivos.join(', '),
    distanciaM: top.dist == null ? null : Math.round(top.dist),
    alternativas: res.slice(1).filter(function (x) { return x.score > 0; }).map(function (x) {
      return { rotaId: x.rota.id, label: labelRota_(x.rota), pontos: Math.round(x.score) };
    })
  };
}
